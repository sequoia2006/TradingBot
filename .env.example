# --- Required ---
WEBHOOK_SECRET=change-me-to-a-long-random-string   # must match the "Webhook secret" input in the Pine script
ADMIN_TOKEN=another-long-random-string             # for /kill, /resume, /status

# --- Broker: paper | tradovate ---
BROKER=paper
TRADOVATE_ENV=demo          # demo | live   (stay on demo until you trust it!)
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=
TRADOVATE_ACCOUNT_ID=       # optional; first account is used if empty

# --- Contract ---
CONTRACT=                   # e.g. MNQZ6. Empty = auto front month with roll

# --- Risk ---
MAX_CONTRACTS=2
MAX_TRADES_PER_DAY=6
DAILY_LOSS_LIMIT=300        # USD; entries blocked once realized+open P&L <= -this
ENTRY_WINDOW=09:35-15:45    # America/New_York; entries outside are rejected (exits always allowed)
MAX_SIGNAL_AGE_SEC=30       # reject stale entry signals
ALLOWED_IPS=                # comma list; e.g. TradingView's: 52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
